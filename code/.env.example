# =========================================================================
# PDF GraphRAG — .env šablóna
# =========================================================================
# Skopíruj tento súbor ako `.env` v koreni projektu a doplň skutočné hodnoty:
#   cp .env.example .env
#
# .env NIKDY necommituj do gitu (mal by byť v .gitignore).
# =========================================================================


# --- Neo4j pripojenie ---
# Lokálna Neo4j Desktop 2 inštancia (predvolený bolt port: 7687)
# Pre Aura / Docker uprav podľa vlastnej URI.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tvoje-neo4j-heslo


# --- LLM API kľúče ---
# OpenAI: GPT-5/4-mini, embeddings (text-embedding-3-large) — povinný pre ODD/SDE
# Získaj na: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini: 2.5 Pro/Flash — záložné/experimentálne extrakcie
# Získaj na: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...
